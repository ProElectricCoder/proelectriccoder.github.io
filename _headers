# Cloudflare Pages response headers
# The Ampere extension downloads its news, updates and add-ons from here on another origin, so these need CORS.
# no-cache keeps new posts and releases from being served stale.
/Projects/NewTab/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate
/ElectronCSS/CubicGradient.js
  Access-Control-Allow-Origin: *
